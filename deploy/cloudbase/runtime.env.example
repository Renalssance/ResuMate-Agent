# Inject in CloudBase Run service settings. Never copy real secrets into the image.
CLOUDBASE_ENV_ID=dev-d0g73fv8v22380036
# Used only for private CloudBase document storage.
CLOUDBASE_APIKEY=
# Fill real credentials, URL-encoding special characters in username/password.
DATABASE_URL=mysql://[DB-USERNAME]:[DB-PASSWORD]@172.17.0.11:3306/dev-d0g73fv8v22380036

# Generate a NEW random secret; do not copy local development secrets.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
ADMIN_INVITE_CODE=

# Use the project's existing OpenAI-compatible model credentials and endpoint.
# Per-user Model / API Key / Base URL can also be changed in Settings.
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=
LLM_MAX_TOKENS=8192
LLM_REQUEST_TIMEOUT_SECONDS=300

# Preserve the project's configured remote embedding provider and model.
EMBEDDING_PROVIDER=qwen
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DEVICE=cpu

PDF_OCR_ENABLED=false
PDF_OCR_MAX_PAGES=8
PORT=8000

# Use the actual application origin; this existing gateway is not bound yet.
CORS_ORIGINS=https://dev-d0g73fv8v22380036-1317520624.ap-shanghai.app.tcloudbase.com
RATE_LIMIT_ENABLED=true
