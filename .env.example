# ===== OpenAI-compatible LLM =====
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=
LLM_MAX_TOKENS=8192
# Explicit provider capacity for environment-driven runs. Personal settings stay separate.
LLM_CONTEXT_WINDOW_TOKENS=
LLM_REQUEST_TIMEOUT_SECONDS=300

# Legacy aliases used by the older chat routes.
ARK_API_KEY=
MODEL=
GRADE_MODEL=
BASE_URL=

# ===== Local storage =====
DATABASE_URL=sqlite:///data/resumate.db
CHROMA_PATH=data/chroma

# ===== Embeddings =====
EMBEDDING_PROVIDER=qwen
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DEVICE=cpu

# ===== Optional PDF OCR =====
PDF_OCR_ENABLED=false
PDF_OCR_MAX_PAGES=8
PDF_OCR_RENDER_SCALE=2.5
PDF_TEXT_MIN_CHARS=30

# ===== Auth =====
JWT_SECRET_KEY=
ADMIN_INVITE_CODE=resumate-agent-admin-2026
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
PASSWORD_PBKDF2_ROUNDS=310000

# ===== API Rate Limit =====
RATE_LIMIT_ENABLED=true

# ===== CORS =====
# Use a comma-separated allowlist in production, for example:
# CORS_ORIGINS=https://yourdomain.com
CORS_ORIGINS=*
BACKEND_CORS_ORIGINS=http://localhost:5173

# ===== Independent Agent worker (optional for older analysis pages) =====
# Native API + native worker: use this broker. Docker Compose runs BOTH services
# inside Docker with its own data volume; do not share live SQLite across the VM boundary.
REDIS_URL=redis://127.0.0.1:6379/0
AGENT_STATE_DIR=data/agent
# API and worker must share this persistent PDF directory.
RESUME_EXPORT_DIR=data/exports

# ===== Optional metadata-only tracing (uv sync --extra telemetry) =====
# Configure all three to enable. Langfuse Cloud or self-hosted >= 4.59.0.
# Prompts, resumes, answers, model text, keys and tool arguments are never exported.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
# Explicit false disables even when credentials are configured.
LANGFUSE_TRACING_ENABLED=true
