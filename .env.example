# ===== OpenAI-compatible LLM =====
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=
LLM_MAX_TOKENS=8192
LLM_REQUEST_TIMEOUT_SECONDS=90

# Legacy aliases used by the older chat routes.
ARK_API_KEY=
MODEL=
GRADE_MODEL=
BASE_URL=

# ===== Local storage =====
DATABASE_URL=sqlite:///data/resumate.db
CHROMA_PATH=data/chroma

# ===== Embeddings =====
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DEVICE=cpu

# ===== Optional PDF OCR =====
PDF_OCR_ENABLED=false
PDF_OCR_MAX_PAGES=8
PDF_OCR_RENDER_SCALE=2.5
PDF_TEXT_MIN_CHARS=30

# ===== Auth =====
JWT_SECRET_KEY=
ADMIN_INVITE_CODE=resumate-agent-admin-2026
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
PASSWORD_PBKDF2_ROUNDS=310000

# ===== API Rate Limit =====
RATE_LIMIT_ENABLED=true

# ===== CORS =====
# Use a comma-separated allowlist in production, for example:
# CORS_ORIGINS=https://yourdomain.com
CORS_ORIGINS=*
BACKEND_CORS_ORIGINS=http://localhost:5173
